    <decisions>
        <description>Used to prevent errors</description>
        <name>Was_a_Price_Book_Entry_Found</name>
        <label>Was a Price Book Entry Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Price_Book_Entry_Found</name>
            <conditionLogic>and</conditionLogic>
